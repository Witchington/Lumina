{
  "name": "lumina",
  "productName": "Lumina",
  "version": "0.9.0",
  "description": "Lumina: a video editor for everything",
  "main": "electron/main.js",
  "private": true,
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.14",
    "ffmpeg-static": "^5.2.0",
    "three": "0.186.1"
  },
  "author": "Lumina <lumina@localhost>",
  "homepage": "https://localhost",
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.lumina.editor",
    "productName": "Lumina",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "**/*",
      "!dist/**"
    ],
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "lumina-icon.png",
      "executableName": "lumina",
      "artifactName": "Lumina-${version}-x86_64.AppImage"
    },
    "directories": {
      "output": "dist"
    }
  }
}